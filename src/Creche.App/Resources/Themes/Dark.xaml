<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Deep blue-grey palette with a softened indigo primary that keeps white text readable. -->
    <SolidColorBrush x:Key="Bg" Color="#0F1118" />
    <SolidColorBrush x:Key="Surface" Color="#171A24" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#20242F" />
    <SolidColorBrush x:Key="Sidebar" Color="#131620" />
    <SolidColorBrush x:Key="Border" Color="#2A2F3D" />
    <SolidColorBrush x:Key="BorderStrong" Color="#3A4052" />
    <SolidColorBrush x:Key="Text" Color="#ECEEF6" />
    <SolidColorBrush x:Key="TextMuted" Color="#959CB3" />
    <SolidColorBrush x:Key="Accent" Color="#6563EE" />
    <SolidColorBrush x:Key="AccentHover" Color="#7472F5" />
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#336563EE" />
    <SolidColorBrush x:Key="AccentStrong" Color="#A9A8FF" />
    <SolidColorBrush x:Key="Highlight" Color="#F5A524" />
    <SolidColorBrush x:Key="HighlightSoft" Color="#2EF5A524" />
    <SolidColorBrush x:Key="Success" Color="#3DD68C" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#263DD68C" />
    <SolidColorBrush x:Key="Danger" Color="#FF6369" />
    <SolidColorBrush x:Key="DangerSoft" Color="#26FF6369" />
    <SolidColorBrush x:Key="Warning" Color="#FF8B3E" />
    <SolidColorBrush x:Key="WarningSoft" Color="#26FF8B3E" />
    <SolidColorBrush x:Key="Info" Color="#70B8FF" />
    <SolidColorBrush x:Key="InfoSoft" Color="#2670B8FF" />
    <SolidColorBrush x:Key="Hover" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="Pressed" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Overlay" Color="#99000000" />
    <Color x:Key="ShadowColor">#000000</Color>
</ResourceDictionary>
