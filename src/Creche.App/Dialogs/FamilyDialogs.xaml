<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Creche.App.Controls"
                    xmlns:loc="clr-namespace:Creche.App.Services"
                    xmlns:vm="clr-namespace:Creche.App.ViewModels">
    <DataTemplate DataType="{x:Type vm:FamilyDialogViewModel}">
        <StackPanel Width="620">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                <c:Field Label="{loc:T Families.Name}">
                    <TextBox Text="{Binding Family.Name}" />
                </c:Field>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                <c:Field Label="{loc:T Common.Address}">
                    <TextBox Text="{Binding Family.Address}" />
                </c:Field>
                    </StackPanel>
                </Grid>
                <c:Field Label="{loc:T Common.Notes}">
                    <TextBox Text="{Binding Family.Notes}" Style="{StaticResource Multiline}" />
                </c:Field>
            <StackPanel Visibility="{Binding IsExisting, Converter={StaticResource Visible}}">
                <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,12">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{loc:T Payments.New}" Command="{Binding PayCommand}" c:Ico.Kind="card"
                                Visibility="{Binding CanPay, Converter={StaticResource Visible}}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Payments.AmountDue}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Due}" Style="{StaticResource BigNumber}" FontSize="18" Foreground="{Binding OwesMoney, Converter={StaticResource StatusBrush}}" />
                            <TextBlock Text="{loc:T Payments.Credit}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="22,0,10,0" Visibility="{Binding Credit, Converter={StaticResource Visible}}" />
                            <TextBlock Text="{Binding Credit}" Style="{StaticResource Mono}" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <DockPanel Margin="0,0,0,5">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Content="{loc:T Common.Add}" Command="{Binding EditGuardianCommand}" c:Ico.Kind="plus" />
                    <TextBlock Text="{loc:T Families.Guardians}" Style="{StaticResource Label}" VerticalAlignment="Bottom" />
                </DockPanel>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,0,12">
                        <Grid MinHeight="46" MaxHeight="170">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Guardians}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,5">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" MinHeight="26" ToolTip="{loc:T Common.Archive}"
                                                            Command="{Binding DataContext.ArchiveGuardianCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                        <c:Icon Kind="archive" Width="14" Height="14" />
                                                    </Button>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" MinHeight="26" ToolTip="{loc:T Common.Edit}"
                                                            Command="{Binding DataContext.EditGuardianCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                        <c:Icon Kind="edit" Width="14" Height="14" />
                                                    </Button>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Phone}" Style="{StaticResource Mono}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{DynamicResource AccentSoft}" Margin="0,0,8,0" Visibility="{Binding IsPrimary, Converter={StaticResource Visible}}">
                                                        <TextBlock Text="{loc:T Families.Primary}" FontSize="11" />
                                                    </Border>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" />
                                                        <TextBlock Style="{StaticResource Muted}" FontSize="11"><Run Text="{Binding Relationship, Mode=OneWay, Converter={StaticResource Enum}}" /><Run Text="  " /><Run Text="{Binding Job, Mode=OneWay}" /></TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="{loc:T Common.Nothing}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Guardians.Count, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                        </Grid>
                    </Border>
                <TextBlock Text="{loc:T Nav.children}" Style="{StaticResource Label}" />
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,0,12">
                        <Grid MinHeight="46" MaxHeight="130">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Children}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,5">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" MinHeight="26" ToolTip="{loc:T Children.File}"
                                                            Command="{Binding DataContext.OpenChildCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                        <c:Icon Kind="file" Width="14" Height="14" />
                                                    </Button>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Status, Converter={StaticResource Enum}}" FontSize="11" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock VerticalAlignment="Center"><Run Text="{Binding FullName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding Group.Name, Mode=OneWay}" /></TextBlock>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="{loc:T Common.Nothing}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Children.Count, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                        </Grid>
                    </Border>
            </StackPanel>
            <TextBlock Text="{loc:T Families.SaveFirst}" Style="{StaticResource Muted}" Visibility="{Binding IsExisting, Converter={StaticResource Visible}, ConverterParameter=invert}" />
            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{loc:T Common.Save}" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="110" />
                <Button DockPanel.Dock="Right" Content="{loc:T Common.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0" MinWidth="90" />
                <Button DockPanel.Dock="Left" Style="{StaticResource DangerBtn}" Content="{loc:T Common.Archive}" Command="{Binding ArchiveCommand}"
                        Visibility="{Binding IsExisting, Converter={StaticResource Visible}}" />
            </DockPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:GuardianDialogViewModel}">
        <StackPanel Width="520">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                <c:Field Label="{loc:T Common.FirstName}">
                    <TextBox Text="{Binding Guardian.FirstName}" />
                </c:Field>
                <c:Field Label="{loc:T Families.Relationship}">
                    <ComboBox ItemsSource="{Binding Relationships}" SelectedValue="{Binding Guardian.Relationship}" SelectedValuePath="Value" DisplayMemberPath="Label" />
                </c:Field>
                <c:Field Label="{loc:T Common.Phone}">
                    <TextBox Text="{Binding Guardian.Phone}" />
                </c:Field>
                <c:Field Label="{loc:T Families.Email}">
                    <TextBox Text="{Binding Guardian.Email}" />
                </c:Field>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                <c:Field Label="{loc:T Common.LastName}">
                    <TextBox Text="{Binding Guardian.LastName}" />
                </c:Field>
                <c:Field Label="{loc:T Families.Job}">
                    <TextBox Text="{Binding Guardian.Job}" />
                </c:Field>
                <c:Field Label="{loc:T Families.Phone2}">
                    <TextBox Text="{Binding Guardian.Phone2}" />
                </c:Field>
                <c:Field Label="{loc:T Common.Address}">
                    <TextBox Text="{Binding Guardian.Address}" />
                </c:Field>
                    </StackPanel>
                </Grid>
            <WrapPanel>
                <CheckBox Content="{loc:T Families.Primary}" IsChecked="{Binding Guardian.IsPrimary}" Margin="0,0,18,6" />
                <CheckBox Content="{loc:T Families.CanPickUp}" IsChecked="{Binding Guardian.CanPickUp}" Margin="0,0,18,6" />
                <CheckBox Content="{loc:T Children.EmergencyContact}" IsChecked="{Binding Guardian.IsEmergencyContact}" Margin="0,0,0,6" />
            </WrapPanel>
            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{loc:T Common.Save}" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="110" />
                <Button DockPanel.Dock="Right" Content="{loc:T Common.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0" MinWidth="90" />
            </DockPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:GroupDialogViewModel}">
        <StackPanel Width="380">
                <c:Field Label="{loc:T Common.Name}">
                    <TextBox Text="{Binding Group.Name}" />
                </c:Field>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                <c:Field Label="{loc:T Groups.MinAge}">
                    <TextBox Text="{Binding Group.MinAgeMonths, Converter={StaticResource Int}}" FontFamily="{StaticResource FontMono}" />
                </c:Field>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                <c:Field Label="{loc:T Groups.MaxAge}">
                    <TextBox Text="{Binding Group.MaxAgeMonths, Converter={StaticResource Int}}" FontFamily="{StaticResource FontMono}" />
                </c:Field>
                    </StackPanel>
                </Grid>
                <c:Field Label="{loc:T Groups.Capacity}">
                    <TextBox Text="{Binding Group.Capacity, Converter={StaticResource Int}}" FontFamily="{StaticResource FontMono}" />
                </c:Field>
            <TextBlock Text="{loc:T Groups.EducatorsHint}" Style="{StaticResource Muted}" />
            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{loc:T Common.Save}" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="110" />
                <Button DockPanel.Dock="Right" Content="{loc:T Common.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0" MinWidth="90" />
            </DockPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:EnrolDialogViewModel}">
        <StackPanel Width="660">
            <TextBlock Text="{loc:T Common.Child}" Style="{StaticResource H2}" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                <c:Field Label="{loc:T Common.FirstName}">
                    <TextBox Text="{Binding Request.FirstName}" />
                </c:Field>
                <c:Field Label="{loc:T Children.BirthDate}">
                    <DatePicker SelectedDate="{Binding BirthDate}" />
                </c:Field>
                <c:Field Label="{loc:T Children.Allergies}">
                    <TextBox Text="{Binding Request.Allergies}" />
                </c:Field>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                <c:Field Label="{loc:T Common.LastName}">
                    <TextBox Text="{Binding Request.LastName}" />
                </c:Field>
                <c:Field Label="{loc:T Children.Sex}">
                    <ComboBox ItemsSource="{Binding Sexes}" SelectedValue="{Binding Request.Sex}" SelectedValuePath="Value" DisplayMemberPath="Label" />
                </c:Field>
                <c:Field Label="{loc:T Children.MedicalNotes}">
                    <TextBox Text="{Binding Request.MedicalNotes}" />
                </c:Field>
                    </StackPanel>
                </Grid>
            <DockPanel Margin="0,4,0,8">
                <CheckBox DockPanel.Dock="Right" Content="{loc:T Enrolment.ExistingFamily}" IsChecked="{Binding ExistingFamily}" />
                <TextBlock Text="{loc:T Common.Family}" Style="{StaticResource H2}" />
            </DockPanel>
            <StackPanel Visibility="{Binding ExistingFamily, Converter={StaticResource Visible}}">
                <c:Field Label="{loc:T Common.Family}">
                    <ComboBox ItemsSource="{Binding Families}" SelectedItem="{Binding Family}" DisplayMemberPath="Label" />
                </c:Field>
            </StackPanel>
            <StackPanel Visibility="{Binding ExistingFamily, Converter={StaticResource Visible}, ConverterParameter=invert}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                <c:Field Label="{loc:T Enrolment.GuardianFirstName}">
                    <TextBox Text="{Binding Request.GuardianFirstName}" />
                </c:Field>
                <c:Field Label="{loc:T Families.Relationship}">
                    <ComboBox ItemsSource="{Binding Relationships}" SelectedValue="{Binding Request.GuardianRelationship}" SelectedValuePath="Value" DisplayMemberPath="Label" />
                </c:Field>
                <c:Field Label="{loc:T Families.Job}">
                    <TextBox Text="{Binding Request.GuardianJob}" />
                </c:Field>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                <c:Field Label="{loc:T Enrolment.GuardianLastName}">
                    <TextBox Text="{Binding Request.GuardianLastName}" />
                </c:Field>
                <c:Field Label="{loc:T Common.Phone}">
                    <TextBox Text="{Binding Request.GuardianPhone}" />
                </c:Field>
                <c:Field Label="{loc:T Common.Address}">
                    <TextBox Text="{Binding Request.Address}" />
                </c:Field>
                    </StackPanel>
                </Grid>
            </StackPanel>
            <DockPanel Margin="0,4,0,8">
                <CheckBox DockPanel.Dock="Right" Content="{loc:T Enrolment.PutOnWaitingList}" IsChecked="{Binding WaitingList}" />
                <TextBlock Text="{loc:T Nav.enrolment}" Style="{StaticResource H2}" />
            </DockPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                <c:Field Label="{loc:T Common.Group}">
                    <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding Group}" DisplayMemberPath="Label" />
                </c:Field>
                <c:Field Label="{loc:T Children.EnrolmentDate}" IsEnabled="{Binding WaitingList, Converter={StaticResource Not}}">
                    <DatePicker SelectedDate="{Binding EnrolmentDate}" />
                </c:Field>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                <c:Field Label="{loc:T Children.FeePlan}">
                    <ComboBox ItemsSource="{Binding Plans}" SelectedItem="{Binding Plan}" DisplayMemberPath="Label" />
                </c:Field>
                <c:Field Label="{loc:T Settings.RegistrationFee}" IsEnabled="{Binding WaitingList, Converter={StaticResource Not}}">
                    <TextBox Text="{Binding RegistrationFee, Converter={StaticResource Decimal}}" FontFamily="{StaticResource FontMono}" />
                </c:Field>
                    </StackPanel>
                </Grid>
            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{loc:T Enrolment.Confirm}" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="110" />
                <Button DockPanel.Dock="Right" Content="{loc:T Common.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0" MinWidth="90" />
            </DockPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:EnrolActionViewModel}">
        <StackPanel Width="400">
            <TextBlock Text="{Binding ChildName}" Style="{StaticResource H2}" Margin="0,0,0,12" />
            <StackPanel Visibility="{Binding IsReEnrol, Converter={StaticResource Visible}}">
                <c:Field Label="{loc:T Settings.SchoolYear}">
                    <TextBox Text="{Binding SchoolYear}" />
                </c:Field>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowsDate, Converter={StaticResource Visible}}">
                <c:Field Label="{loc:T Common.Date}">
                    <DatePicker SelectedDate="{Binding Date}" />
                </c:Field>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowsPlacement, Converter={StaticResource Visible}}">
                <c:Field Label="{loc:T Common.Group}">
                    <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding Group}" DisplayMemberPath="Label" />
                </c:Field>
                <c:Field Label="{loc:T Children.FeePlan}">
                    <ComboBox ItemsSource="{Binding Plans}" SelectedItem="{Binding Plan}" DisplayMemberPath="Label" />
                </c:Field>
                <c:Field Label="{loc:T Enrolment.Fee}">
                    <TextBox Text="{Binding Fee, Converter={StaticResource Decimal}}" FontFamily="{StaticResource FontMono}" />
                </c:Field>
            </StackPanel>
            <StackPanel Visibility="{Binding IsLeave, Converter={StaticResource Visible}}">
                <c:Field Label="{loc:T Enrolment.LeaveReason}">
                    <TextBox Text="{Binding Reason}" Style="{StaticResource Multiline}" />
                </c:Field>
            </StackPanel>
            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{loc:T Common.Confirm}" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="110" />
                <Button DockPanel.Dock="Right" Content="{loc:T Common.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0" MinWidth="90" />
            </DockPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
