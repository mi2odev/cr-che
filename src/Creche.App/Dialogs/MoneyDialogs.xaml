<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Creche.App.Controls"
                    xmlns:loc="clr-namespace:Creche.App.Services"
                    xmlns:vm="clr-namespace:Creche.App.ViewModels">
    <DataTemplate DataType="{x:Type vm:PaymentDialogViewModel}">
        <StackPanel Width="440">
                <c:Field Label="{loc:T Common.Family}">
                    <ComboBox ItemsSource="{Binding Families}" SelectedItem="{Binding Family}" DisplayMemberPath="Name" />
                </c:Field>
            <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Due}" Style="{StaticResource BigNumber}" FontSize="18" />
                    <TextBlock Text="{loc:T Payments.AmountDue}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                <c:Field Label="{loc:T Common.Amount}">
                    <TextBox Text="{Binding Amount, Converter={StaticResource Decimal}, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" FontSize="16" />
                </c:Field>
                <c:Field Label="{loc:T Common.Date}">
                    <DatePicker SelectedDate="{Binding Date}" />
                </c:Field>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                <c:Field Label="{loc:T Payments.Method}">
                    <ComboBox ItemsSource="{Binding Methods}" SelectedValue="{Binding Method}" SelectedValuePath="Value" DisplayMemberPath="Label" />
                </c:Field>
                <c:Field Label="{loc:T Payments.Reference}">
                    <TextBox Text="{Binding Reference}" />
                </c:Field>
                    </StackPanel>
                </Grid>
            <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" Margin="0,-4,0,10" Visibility="{Binding Hint, Converter={StaticResource Visible}}" />
                <c:Field Label="{loc:T Common.Notes}">
                    <TextBox Text="{Binding Notes}" />
                </c:Field>
            <CheckBox Content="{loc:T Payments.PrintReceipt}" IsChecked="{Binding PrintReceipt}" />
            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{loc:T Payments.Record}" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="110" />
                <Button DockPanel.Dock="Right" Content="{loc:T Common.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0" MinWidth="90" />
            </DockPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:InvoiceDialogViewModel}">
        <StackPanel Width="560">
            <DockPanel Margin="0,0,0,12">
                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{Binding Invoice.Status, Converter={StaticResource StatusBrush}, ConverterParameter=soft}" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Invoice.Status, Converter={StaticResource Enum}}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding Invoice.Status, Converter={StaticResource StatusBrush}}" />
                </Border>
                <StackPanel>
                    <TextBlock Text="{Binding Invoice.Child.FullName}" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Muted}">
                        <Run Text="{Binding Invoice.Family.Name, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Invoice.Period, Mode=OneWay, Converter={StaticResource Date}, ConverterParameter=month}" />
                        <Run Text="  ·  " /><Run Text="{loc:T Billing.DueDate}" /><Run Text=" " /><Run Text="{Binding Invoice.DueDate, Mode=OneWay, Converter={StaticResource Date}}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,0,12">
                        <Grid MinHeight="46" MaxHeight="230">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Lines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,5">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Amount, Converter={StaticResource Money}}" Style="{StaticResource Mono}" />
                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="{loc:T Common.Nothing}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Lines.Count, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                        </Grid>
                    </Border>
            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Invoice.Total, Converter={StaticResource Money}}" Style="{StaticResource Mono}" FontWeight="Bold" MinWidth="150" TextAlignment="Right" />
                <TextBlock DockPanel.Dock="Right" Text="{loc:T Common.Total}" Style="{StaticResource Muted}" />
            </DockPanel>
            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Invoice.PaidAmount, Converter={StaticResource Money}}" Style="{StaticResource Mono}" MinWidth="150" TextAlignment="Right" />
                <TextBlock DockPanel.Dock="Right" Text="{loc:T Billing.Paid}" Style="{StaticResource Muted}" />
            </DockPanel>
            <DockPanel LastChildFill="False" Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Invoice.Remaining, Converter={StaticResource Money}}" Style="{StaticResource BigNumber}" FontSize="17" MinWidth="150" TextAlignment="Right" />
                <TextBlock DockPanel.Dock="Right" Text="{loc:T Billing.Remaining}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{loc:T Payments.History}" Style="{StaticResource Label}" Visibility="{Binding Allocations.Count, Converter={StaticResource Visible}}" />
            <ItemsControl ItemsSource="{Binding Allocations}" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Amount, Converter={StaticResource Money}}" Style="{StaticResource Mono}" FontSize="12" />
                            <TextBlock FontSize="12"><Run Text="{Binding Payment.ReceiptNumber, Mode=OneWay}" FontFamily="{StaticResource FontMono}" /><Run Text="   " /><Run Text="{Binding Payment.Date, Mode=OneWay, Converter={StaticResource Date}}" /></TextBlock>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{loc:T Payments.New}" Command="{Binding PayCommand}" c:Ico.Kind="card"
                        Visibility="{Binding CanPay, Converter={StaticResource Visible}}" />
                <Button DockPanel.Dock="Right" Content="{loc:T Common.Print}" Command="{Binding PrintCommand}" c:Ico.Kind="printer" Margin="0,0,8,0" />
                <Button DockPanel.Dock="Right" Content="{loc:T Common.Close}" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                <Button DockPanel.Dock="Left" Style="{StaticResource DangerBtn}" Content="{loc:T Billing.CancelInvoice}" Command="{Binding CancelInvoiceCommand}"
                        Visibility="{Binding CanCancel, Converter={StaticResource Visible}}" />
            </DockPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ExtraChargeDialogViewModel}">
        <StackPanel Width="400">
                <c:Field Label="{loc:T Common.Child}">
                    <ComboBox ItemsSource="{Binding Children}" SelectedItem="{Binding Child}" DisplayMemberPath="FullName" />
                </c:Field>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                <c:Field Label="{loc:T Billing.ChargeKind}">
                    <ComboBox ItemsSource="{Binding Kinds}" SelectedValue="{Binding Kind}" SelectedValuePath="Value" DisplayMemberPath="Label" />
                </c:Field>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                <c:Field Label="{loc:T Common.Date}">
                    <DatePicker SelectedDate="{Binding Date}" />
                </c:Field>
                    </StackPanel>
                </Grid>
                <c:Field Label="{loc:T Common.Description}">
                    <TextBox Text="{Binding Description}" />
                </c:Field>
                <c:Field Label="{loc:T Common.Amount}">
                    <TextBox Text="{Binding Amount, Converter={StaticResource Decimal}}" FontFamily="{StaticResource FontMono}" />
                </c:Field>
            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{loc:T Common.Save}" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="110" />
                <Button DockPanel.Dock="Right" Content="{loc:T Common.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0" MinWidth="90" />
            </DockPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:FeePlanDialogViewModel}">
        <StackPanel Width="420">
                <c:Field Label="{loc:T Common.Name}">
                    <TextBox Text="{Binding Plan.Name}" />
                </c:Field>
                <c:Field Label="{loc:T Billing.PlanType}">
                    <ComboBox ItemsSource="{Binding Types}" SelectedValue="{Binding Plan.Type}" SelectedValuePath="Value" DisplayMemberPath="Label" />
                </c:Field>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                <c:Field Label="{loc:T Billing.MonthlyAmount}">
                    <TextBox Text="{Binding Plan.MonthlyAmount, Converter={StaticResource Decimal}}" FontFamily="{StaticResource FontMono}" />
                </c:Field>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                <c:Field Label="{loc:T Billing.HourlyRate}">
                    <TextBox Text="{Binding Plan.HourlyRate, Converter={StaticResource Decimal}}" FontFamily="{StaticResource FontMono}" />
                </c:Field>
                    </StackPanel>
                </Grid>
            <CheckBox Content="{loc:T Billing.IncludesMeals}" IsChecked="{Binding Plan.IncludesMeals}" Margin="0,0,0,10" />
                <c:Field Label="{loc:T Billing.Meals}">
                    <TextBox Text="{Binding Plan.MealsAmount, Converter={StaticResource Decimal}}" FontFamily="{StaticResource FontMono}" />
                </c:Field>
            <CheckBox Content="{loc:T Common.Active}" IsChecked="{Binding Plan.IsActive}" />
            <TextBlock Text="{loc:T Billing.PlanHelp}" Style="{StaticResource Muted}" Margin="0,10,0,0" />
            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{loc:T Common.Save}" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="110" />
                <Button DockPanel.Dock="Right" Content="{loc:T Common.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0" MinWidth="90" />
            </DockPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ExpenseDialogViewModel}">
        <StackPanel Width="400">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                <c:Field Label="{loc:T Common.Date}">
                    <DatePicker SelectedDate="{Binding Date}" />
                </c:Field>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                <c:Field Label="{loc:T Expenses.Category}">
                    <ComboBox ItemsSource="{Binding Categories}" SelectedValue="{Binding Expense.Category}" SelectedValuePath="Value" DisplayMemberPath="Label" />
                </c:Field>
                    </StackPanel>
                </Grid>
                <c:Field Label="{loc:T Common.Description}">
                    <TextBox Text="{Binding Expense.Description}" />
                </c:Field>
                <c:Field Label="{loc:T Common.Amount}">
                    <TextBox Text="{Binding Expense.Amount, Converter={StaticResource Decimal}}" FontFamily="{StaticResource FontMono}" />
                </c:Field>
            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{loc:T Common.Save}" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="110" />
                <Button DockPanel.Dock="Right" Content="{loc:T Common.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0" MinWidth="90" />
            </DockPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:StaffDialogViewModel}">
        <StackPanel Width="520">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                <c:Field Label="{loc:T Common.FirstName}">
                    <TextBox Text="{Binding Staff.FirstName}" />
                </c:Field>
                <c:Field Label="{loc:T Staff.Role}">
                    <ComboBox ItemsSource="{Binding Roles}" SelectedValue="{Binding Staff.Role}" SelectedValuePath="Value" DisplayMemberPath="Label" />
                </c:Field>
                <c:Field Label="{loc:T Staff.Salary}">
                    <TextBox Text="{Binding Staff.MonthlySalary, Converter={StaticResource Decimal}}" FontFamily="{StaticResource FontMono}" />
                </c:Field>
                <c:Field Label="{loc:T Common.Phone}">
                    <TextBox Text="{Binding Staff.Phone}" />
                </c:Field>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                <c:Field Label="{loc:T Common.LastName}">
                    <TextBox Text="{Binding Staff.LastName}" />
                </c:Field>
                <c:Field Label="{loc:T Common.Group}">
                    <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding Group}" DisplayMemberPath="Label" />
                </c:Field>
                <c:Field Label="{loc:T Staff.HireDate}">
                    <DatePicker SelectedDate="{Binding HireDate}" />
                </c:Field>
                <c:Field Label="{loc:T Common.Address}">
                    <TextBox Text="{Binding Staff.Address}" />
                </c:Field>
                    </StackPanel>
                </Grid>
                <c:Field Label="{loc:T Common.Notes}">
                    <TextBox Text="{Binding Staff.Notes}" Style="{StaticResource Multiline}" />
                </c:Field>
            <CheckBox Content="{loc:T Common.Active}" IsChecked="{Binding Staff.IsActive}" />
            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{loc:T Common.Save}" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="110" />
                <Button DockPanel.Dock="Right" Content="{loc:T Common.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0" MinWidth="90" />
            </DockPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:UserDialogViewModel}">
        <StackPanel Width="400">
                <c:Field Label="{loc:T Login.Username}">
                    <TextBox Text="{Binding Edit.Username}" />
                </c:Field>
                <c:Field Label="{loc:T Common.Name}">
                    <TextBox Text="{Binding Edit.DisplayName}" />
                </c:Field>
                <c:Field Label="{loc:T Users.Role}">
                    <ComboBox ItemsSource="{Binding Roles}" SelectedValue="{Binding Role}" SelectedValuePath="Value" DisplayMemberPath="Label" />
                </c:Field>
            <StackPanel Visibility="{Binding IsEducator, Converter={StaticResource Visible}}">
                <c:Field Label="{loc:T Users.Group}">
                    <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding Group}" DisplayMemberPath="Label" />
                </c:Field>
            </StackPanel>
            <c:Field Label="{loc:T Users.Password}">
                <PasswordBox loc:PasswordHelper.Password="{Binding Password, Mode=TwoWay}" />
            </c:Field>
            <TextBlock Text="{loc:T Users.PasswordHint}" Style="{StaticResource Muted}" Margin="0,-6,0,10" Visibility="{Binding IsNew, Converter={StaticResource Visible}, ConverterParameter=invert}" />
            <CheckBox Content="{loc:T Common.Active}" IsChecked="{Binding Edit.IsActive}" />
            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{loc:T Common.Save}" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="110" />
                <Button DockPanel.Dock="Right" Content="{loc:T Common.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0" MinWidth="90" />
            </DockPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
