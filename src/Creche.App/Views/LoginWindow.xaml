<Window x:Class="Creche.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Creche.App.Controls"
        xmlns:loc="clr-namespace:Creche.App.Services"
        Title="{Binding CrecheName}" Width="420" SizeToContent="Height" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="{StaticResource FontUi}" FontSize="13"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" Icon="/Resources/Images/app.ico">
    <StackPanel Margin="36,30,36,30">
        <Grid Width="76" Height="76" HorizontalAlignment="Center">
            <Image Source="/Resources/Images/logo.png" Visibility="{Binding LogoFile, Converter={StaticResource Visible}, ConverterParameter=invert}" />
            <c:Avatar FileName="{Binding LogoFile}" Width="76" Height="76" Background="Transparent"
                      Visibility="{Binding LogoFile, Converter={StaticResource Visible}}" />
        </Grid>
        <TextBlock Text="{Binding CrecheName}" Style="{StaticResource H1}" TextAlignment="Center" Margin="0,14,0,2" TextWrapping="Wrap" />
        <TextBlock Text="{loc:T Login.Subtitle}" Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,0,0,22" />

        <c:Field Label="{loc:T Login.Username}">
            <TextBox x:Name="username" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
        </c:Field>
        <c:Field Label="{loc:T Login.Password}">
            <PasswordBox x:Name="password" loc:PasswordHelper.Password="{Binding Password, Mode=TwoWay}" />
        </c:Field>

        <Border Background="{DynamicResource DangerSoft}" CornerRadius="8" Padding="10,7" Margin="0,0,0,12"
                Visibility="{Binding Error, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
        </Border>
        <Border Background="{DynamicResource InfoSoft}" CornerRadius="8" Padding="10,7" Margin="0,0,0,12"
                Visibility="{Binding ShowFirstRunHint, Converter={StaticResource Visible}}">
            <TextBlock Text="{loc:T Login.FirstRun}" Foreground="{DynamicResource Info}" TextWrapping="Wrap" />
        </Border>

        <Button Style="{StaticResource Primary}" Content="{loc:T Login.SignIn}" Command="{Binding LoginCommand}" IsDefault="True" c:Ico.Kind="login" MinHeight="38" />

        <DockPanel Margin="0,22,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Click="OnToggleTheme" ToolTip="{loc:T Settings.Theme}">
                <c:Icon Kind="sun" Width="16" Height="16" />
            </Button>
            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" DisplayMemberPath="Label" Width="150" HorizontalAlignment="Left" />
        </DockPanel>
    </StackPanel>
</Window>
