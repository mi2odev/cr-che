<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Creche.App.Controls"
                    xmlns:loc="clr-namespace:Creche.App.Services"
                    xmlns:vm="clr-namespace:Creche.App.ViewModels">
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,22,28,28" MaxWidth="1500">
                <!-- Greeting -->
                <DockPanel Margin="0,0,0,18">
                    <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" c:Ico.Kind="refresh" Content="{loc:T Common.Refresh}" VerticalAlignment="Center" ToolTip="F5" />
                    <StackPanel>
                        <TextBlock Text="{Binding Greeting}" Style="{StaticResource H1}" FontSize="26" />
                        <TextBlock Text="{Binding Date, Converter={StaticResource Date}, ConverterParameter=long}" Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- Today's attendance at a glance -->
                <Button Style="{StaticResource Bare}" Command="{Binding GoCommand}" CommandParameter="attendance" Margin="0,0,0,12">
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Center">
                                <Border CornerRadius="14" Background="{DynamicResource SuccessSoft}" />
                                <c:Icon Kind="check-circle" Width="22" Height="22" Foreground="{DynamicResource Success}" />
                            </Grid>
                            <c:Icon DockPanel.Dock="Right" Kind="chevron-right" Width="18" Height="18" Foreground="{DynamicResource TextMuted}" Margin="14,0,0,0" VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <StackPanel Margin="0,0,22,0">
                                    <TextBlock Text="{loc:T Dashboard.Present}" Style="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding Present}" Style="{StaticResource BigNumber}" Foreground="{DynamicResource Success}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,22,0">
                                    <TextBlock Text="{loc:T Dashboard.Absent}" Style="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding Absent}" Style="{StaticResource BigNumber}" Foreground="{DynamicResource Danger}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{loc:T Dashboard.NotMarked}" Style="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding NotMarked}" Style="{StaticResource BigNumber}" Foreground="{DynamicResource Info}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:T Dashboard.TodayAttendance}" Style="{StaticResource H2}" />
                                <TextBlock Text="{Binding AttendanceText}" Style="{StaticResource Muted}" Margin="0,2,0,8" />
                                <c:Meter Value="{Binding MarkedRatio}" Height="8" MaxWidth="420" HorizontalAlignment="Left" Track="{DynamicResource SurfaceAlt}" Fill="{DynamicResource Success}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Button>

                <!-- Quick actions -->
                <TextBlock Text="{loc:T Dashboard.QuickActions}" Style="{StaticResource Caption}" FontSize="12" Margin="2,6,0,8"
                           Visibility="{Binding Actions.Count, Converter={StaticResource Visible}}" />
                <ItemsControl ItemsSource="{Binding Actions}" Margin="0,0,0,14" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <c:ResponsiveGrid MinColumnWidth="200" MaxColumns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Bare}" Command="{Binding DataContext.RunActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <Border Style="{StaticResource Card}" Padding="14">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Left" Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Border CornerRadius="11" Background="{Binding Tone, Converter={StaticResource Tone}, ConverterParameter=soft}" />
                                            <c:Icon Kind="{Binding Icon}" Width="18" Height="18" Foreground="{Binding Tone, Converter={StaticResource Tone}}" />
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Key figures: each tile opens the matching screen -->
                <TextBlock Text="{loc:T Dashboard.KeyFigures}" Style="{StaticResource Caption}" FontSize="12" Margin="2,0,0,8" />
                <c:ResponsiveGrid MinColumnWidth="230" MaxColumns="5">
                    <Button Style="{StaticResource Bare}" Command="{Binding GoCommand}" CommandParameter="children">
                        <c:StatCard Title="{loc:T Dashboard.ActiveChildren}" Value="{Binding ActiveChildren}" Icon="smile" Foreground="{DynamicResource Accent}" />
                    </Button>
                    <Button Style="{StaticResource Bare}" Command="{Binding GoCommand}" CommandParameter="groups">
                        <c:StatCard Title="{loc:T Dashboard.FreePlaces}" Value="{Binding FreePlaces}" Icon="grid" Foreground="{DynamicResource Info}" />
                    </Button>
                    <Button Style="{StaticResource Bare}" Command="{Binding GoCommand}" CommandParameter="payments">
                        <c:StatCard Title="{loc:T Dashboard.Received}" Value="{Binding Received}" Icon="money" Foreground="{DynamicResource Success}" />
                    </Button>
                    <Button Style="{StaticResource Bare}" Command="{Binding GoCommand}" CommandParameter="billing">
                        <c:StatCard Title="{loc:T Dashboard.FeesDue}" Value="{Binding FeesDue}" Icon="file" Foreground="{DynamicResource Warning}" />
                    </Button>
                    <Button Style="{StaticResource Bare}" Command="{Binding GoCommand}" CommandParameter="payments">
                        <c:StatCard Title="{loc:T Dashboard.FeesOverdue}" Value="{Binding FeesOverdue}" Icon="alert" Foreground="{DynamicResource Danger}" />
                    </Button>
                </c:ResponsiveGrid>

                <c:ResponsiveGrid MinColumnWidth="320" MaxColumns="3" Margin="0,12,0,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{loc:T Dashboard.Places}" Style="{StaticResource H2}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Occupancy}" Style="{StaticResource Mono}" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            </DockPanel>
                                            <c:Meter Value="{Binding Ratio}" Height="7" Margin="0,5,0,3" Track="{DynamicResource SurfaceAlt}" Fill="{Binding IsFull, Converter={StaticResource StatusBrush}}" />
                                            <TextBlock Text="{Binding Free}" Style="{StaticResource Muted}" FontSize="11" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{loc:T Common.Nothing}" Style="{StaticResource Muted}" Visibility="{Binding Groups.Count, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{loc:T Dashboard.Alerts}" Style="{StaticResource H2}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Alerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Tone, Converter={StaticResource Tone}, ConverterParameter=soft}" CornerRadius="8" Margin="0,0,0,7" Padding="10,8" Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenAlertCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <DockPanel>
                                                <c:Icon DockPanel.Dock="Left" Kind="bell" Width="15" Height="15" Margin="0,1,9,0" VerticalAlignment="Top"
                                                        Foreground="{Binding Tone, Converter={StaticResource Tone}}" />
                                                <c:Icon DockPanel.Dock="Right" Kind="chevron-right" Width="14" Height="14" Margin="8,1,0,0" VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TextMuted}" Visibility="{Binding CanOpen, Converter={StaticResource Visible}}" />
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource Text}" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <c:EmptyState Icon="check-circle" Title="{loc:T Dashboard.AllGood}" Text="{loc:T Dashboard.NoAlerts}" Margin="0,8"
                                          Visibility="{Binding Alerts.Count, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{loc:T Dashboard.Birthdays}" Style="{StaticResource H2}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Birthdays}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,10" Background="Transparent" Cursor="Hand">
                                            <DockPanel.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenChildCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            </DockPanel.InputBindings>
                                            <c:Icon DockPanel.Dock="Left" Kind="gift" Width="17" Height="17" Margin="0,0,10,0" Foreground="{DynamicResource Highlight}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding NextBirthday, Converter={StaticResource Date}}" Style="{StaticResource Mono}" FontSize="12" VerticalAlignment="Center" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource Muted}" FontSize="11">
                                                    <Run Text="{Binding TurningAge, Mode=OneWay, Converter={StaticResource Format}, ConverterParameter=Dashboard.Turning}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding DaysUntil, Mode=OneWay, Converter={StaticResource Format}, ConverterParameter=Dashboard.InDays}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <c:EmptyState Icon="gift" Text="{loc:T Dashboard.NoBirthdays}" Margin="0,8"
                                          Visibility="{Binding Birthdays.Count, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Border>
                </c:ResponsiveGrid>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
