<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Creche.App.Controls"
                    xmlns:loc="clr-namespace:Creche.App.Services"
                    xmlns:vm="clr-namespace:Creche.App.ViewModels">
    <DataTemplate DataType="{x:Type vm:FamiliesViewModel}">
        <DockPanel Margin="26,20,26,20">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ExportCsvCommand}" c:Ico.Kind="download" Content="CSV" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Primary}" Command="{Binding AddCommand}" c:Ico.Kind="plus" Content="{loc:T Families.New}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{loc:T Nav.families}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding Count}" Style="{StaticResource Muted}" />
                </StackPanel>
            </DockPanel>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" Width="280" Margin="0,0,12,6" ToolTip="{loc:T Common.Search}" />
                <CheckBox Content="{loc:T Common.ShowArchived}" IsChecked="{Binding IncludeArchived}" Margin="0,0,0,6" />
            </WrapPanel>
            <Border Style="{StaticResource Card}" Padding="6">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" loc:GridState.Key="families">
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenCommand}" />
                        <KeyBinding Key="Enter" Command="{Binding OpenCommand}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:T Common.Family}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="{loc:T Families.Guardian}" Binding="{Binding PrimaryGuardian}" Width="*" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="{loc:T Common.Phone}" Binding="{Binding Phone}" Width="140" ElementStyle="{StaticResource CellMono}" />
                        <DataGridTextColumn Header="{loc:T Nav.children}" Binding="{Binding ChildrenNames}" Width="1.4*" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="{loc:T Payments.AmountDue}" Binding="{Binding Balance, Converter={StaticResource Money}}" SortMemberPath="Balance" Width="150" ElementStyle="{StaticResource CellNumber}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
