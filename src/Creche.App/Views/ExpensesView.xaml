<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Creche.App.Controls"
                    xmlns:loc="clr-namespace:Creche.App.Services"
                    xmlns:vm="clr-namespace:Creche.App.ViewModels">
    <DataTemplate DataType="{x:Type vm:ExpensesViewModel}">
        <DockPanel Margin="26,20,26,20">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ExportCsvCommand}" c:Ico.Kind="download" Content="CSV" Margin="0,0,8,0" />
                    <Button Command="{Binding SalariesCommand}" c:Ico.Kind="briefcase" Content="{loc:T Expenses.Salaries}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Primary}" Command="{Binding EditCommand}" c:Ico.Kind="plus" Content="{loc:T Expenses.New}" />
                </StackPanel>
                <TextBlock Text="{loc:T Nav.expenses}" Style="{StaticResource H1}" />
            </DockPanel>
            <c:ResponsiveGrid DockPanel.Dock="Top" MinColumnWidth="220" MaxColumns="3" Margin="0,0,0,12">
                <c:StatCard Title="{loc:T Expenses.Received}" Value="{Binding Received}" Icon="money" Foreground="{DynamicResource Success}" />
                <c:StatCard Title="{loc:T Expenses.Spent}" Value="{Binding Spent}" Icon="trending-down" Foreground="{DynamicResource Danger}" />
                <c:StatCard Title="{loc:T Reports.NetProfit}" Value="{Binding Net}" Icon="chart" />
            </c:ResponsiveGrid>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <DatePicker SelectedDate="{Binding From}" Width="150" Margin="0,0,6,6" />
                <DatePicker SelectedDate="{Binding To}" Width="150" Margin="0,0,10,6" />
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Label" Width="180" Margin="0,0,0,6" />
            </WrapPanel>
            <Border Style="{StaticResource Card}" Padding="6">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" loc:GridState.Key="expenses">
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}" CommandParameter="{Binding Selected}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:T Common.Date}" Binding="{Binding Date, Converter={StaticResource Date}}" SortMemberPath="Date" Width="110" ElementStyle="{StaticResource CellMono}" />
                        <DataGridTextColumn Header="{loc:T Expenses.Category}" Binding="{Binding Category, Converter={StaticResource Enum}}" SortMemberPath="Category" Width="160" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="{loc:T Common.Description}" Binding="{Binding Description}" Width="*" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="{loc:T Common.Amount}" Binding="{Binding Amount, Converter={StaticResource Money}}" SortMemberPath="Amount" Width="150" ElementStyle="{StaticResource CellNumber}" />
                            <DataGridTemplateColumn Width="Auto" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource Ghost}" MinHeight="28" ToolTip="{loc:T Common.Edit}"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                <c:Icon Kind="edit" Width="14" Height="14" />
                                            </Button>
                                            <Button Style="{StaticResource Ghost}" MinHeight="28" ToolTip="{loc:T Common.Delete}"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                <c:Icon Kind="x" Width="14" Height="14" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
