<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Creche.App.Controls"
                    xmlns:loc="clr-namespace:Creche.App.Services"
                    xmlns:vm="clr-namespace:Creche.App.ViewModels">
    <DataTemplate DataType="{x:Type vm:StaffViewModel}">
        <DockPanel Margin="26,20,26,20">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ExportCsvCommand}" c:Ico.Kind="download" Content="CSV" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Primary}" Command="{Binding EditCommand}" c:Ico.Kind="plus" Content="{loc:T Staff.New}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{loc:T Nav.staff}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding Payroll}" Style="{StaticResource Muted}" />
                </StackPanel>
            </DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" Content="{loc:T Staff.Employees}" IsChecked="{Binding Tab, Converter={StaticResource Is}, ConverterParameter=list}" />
                    <RadioButton Style="{StaticResource Segment}" Content="{loc:T Staff.Attendance}" IsChecked="{Binding Tab, Converter={StaticResource Is}, ConverterParameter=attendance}" />
                </StackPanel>
            </Border>
            <Grid>
                <DockPanel Visibility="{Binding Tab, Converter={StaticResource IsVisible}, ConverterParameter=list}">
                    <CheckBox DockPanel.Dock="Top" Content="{loc:T Staff.ShowInactive}" IsChecked="{Binding IncludeInactive}" Margin="0,0,0,10" HorizontalAlignment="Left" />
                    <Border Style="{StaticResource Card}" Padding="6">
                        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" loc:GridState.Key="staff">
                            <DataGrid.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}" CommandParameter="{Binding Selected}" />
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:T Common.LastName}" Binding="{Binding LastName}" Width="*" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{loc:T Common.FirstName}" Binding="{Binding FirstName}" Width="*" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{loc:T Staff.Role}" Binding="{Binding Role, Converter={StaticResource Enum}}" SortMemberPath="Role" Width="150" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{loc:T Common.Group}" Binding="{Binding Group.Name}" Width="130" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{loc:T Common.Phone}" Binding="{Binding Phone}" Width="140" ElementStyle="{StaticResource CellMono}" />
                                <DataGridTextColumn Header="{loc:T Staff.Salary}" Binding="{Binding MonthlySalary, Converter={StaticResource Money}}" SortMemberPath="MonthlySalary" Width="150" ElementStyle="{StaticResource CellNumber}" />
                                <DataGridCheckBoxColumn Header="{loc:T Common.Active}" Binding="{Binding IsActive}" Width="80" />
                            <DataGridTemplateColumn Width="Auto" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource Ghost}" MinHeight="28" ToolTip="{loc:T Common.Edit}"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                <c:Icon Kind="edit" Width="14" Height="14" />
                                            </Button>
                                            <Button Style="{StaticResource Ghost}" MinHeight="28" ToolTip="{loc:T Common.EnableDisable}"
                                                    Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                <c:Icon Kind="lock" Width="14" Height="14" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>

                <DockPanel Visibility="{Binding Tab, Converter={StaticResource IsVisible}, ConverterParameter=attendance}">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button Style="{StaticResource Ghost}" Command="{Binding ShiftDayCommand}" CommandParameter="-1" Margin="0,0,2,6"><c:Icon Kind="chevron-left" Width="15" Height="15" /></Button>
                <DatePicker SelectedDate="{Binding Date}" Width="150" Margin="0,0,2,6" />
                <Button Style="{StaticResource Ghost}" Command="{Binding ShiftDayCommand}" CommandParameter="1" Margin="0,0,10,6"><c:Icon Kind="chevron-right" Width="15" Height="15" /></Button>
                    </WrapPanel>
                    <Border Style="{StaticResource Card}" Padding="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Attendance}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="10,8">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <TextBox Text="{Binding CheckIn, UpdateSourceTrigger=PropertyChanged}" Width="62" FontFamily="{StaticResource FontMono}" TextAlignment="Center" ToolTip="{loc:T Attendance.CheckIn}" />
                                                    <TextBox Text="{Binding CheckOut, UpdateSourceTrigger=PropertyChanged}" Width="62" FontFamily="{StaticResource FontMono}" TextAlignment="Center" Margin="5,0,10,0" ToolTip="{loc:T Attendance.CheckOut}" />
                                                    <Button Style="{StaticResource SuccessBtn}" Content="{loc:T Enum.StaffAttendanceStatus.Present}" Margin="0,0,6,0"
                                                            Command="{Binding DataContext.MarkPresentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource DangerBtn}" Content="{loc:T Enum.StaffAttendanceStatus.Absent}" Margin="0,0,6,0"
                                                            Command="{Binding DataContext.MarkAbsentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                    <Button Content="{loc:T Enum.StaffAttendanceStatus.Leave}"
                                                            Command="{Binding DataContext.MarkLeaveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                </StackPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Margin="10,0,16,0"
                                                        Background="{Binding Item.Status, Converter={StaticResource StatusBrush}, ConverterParameter=soft}"
                                                        Visibility="{Binding IsMarked, Converter={StaticResource Visible}}">
                                                    <TextBlock Text="{Binding Item.Status, Converter={StaticResource Enum}}" FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="{Binding Item.Status, Converter={StaticResource StatusBrush}}" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Item.FullName}" FontWeight="SemiBold" FontSize="14" />
                                                    <TextBlock Text="{Binding Item.Role, Converter={StaticResource Enum}}" Style="{StaticResource Muted}" FontSize="11" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Grid>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
