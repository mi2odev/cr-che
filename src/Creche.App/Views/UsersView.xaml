<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Creche.App.Controls"
                    xmlns:loc="clr-namespace:Creche.App.Services"
                    xmlns:vm="clr-namespace:Creche.App.ViewModels">
    <DataTemplate DataType="{x:Type vm:UsersViewModel}">
        <DockPanel Margin="26,20,26,20">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Command="{Binding EditCommand}" c:Ico.Kind="plus" Content="{loc:T Users.New}" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="{loc:T Nav.users}" Style="{StaticResource H1}" />
                    <TextBlock Text="{loc:T Users.Hint}" Style="{StaticResource Muted}" />
                </StackPanel>
            </DockPanel>
            <Border Style="{StaticResource Card}" Padding="6">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" loc:GridState.Key="users">
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}" CommandParameter="{Binding Selected}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:T Login.Username}" Binding="{Binding Username}" Width="180" ElementStyle="{StaticResource CellMono}" />
                        <DataGridTextColumn Header="{loc:T Common.Name}" Binding="{Binding DisplayName}" Width="*" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="{loc:T Users.Role}" Binding="{Binding Role, Converter={StaticResource Enum}}" SortMemberPath="Role" Width="160" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="{loc:T Common.Group}" Binding="{Binding GroupName}" Width="140" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="{loc:T Users.LastLogin}" Binding="{Binding LastLoginAt, Converter={StaticResource Date}, ConverterParameter=datetime}" SortMemberPath="LastLoginAt" Width="160" ElementStyle="{StaticResource CellMono}" />
                        <DataGridCheckBoxColumn Header="{loc:T Common.Active}" Binding="{Binding IsActive}" Width="80" />
                            <DataGridTemplateColumn Width="Auto" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource Ghost}" MinHeight="28" ToolTip="{loc:T Common.Edit}"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                <c:Icon Kind="edit" Width="14" Height="14" />
                                            </Button>
                                            <Button Style="{StaticResource Ghost}" MinHeight="28" ToolTip="{loc:T Common.EnableDisable}"
                                                    Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                <c:Icon Kind="lock" Width="14" Height="14" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
