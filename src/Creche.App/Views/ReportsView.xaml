<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Creche.App.Controls"
                    xmlns:loc="clr-namespace:Creche.App.Services"
                    xmlns:vm="clr-namespace:Creche.App.ViewModels">
    <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="26,20,26,24">
                <DockPanel Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ExportCsvCommand}" c:Ico.Kind="download" Content="CSV" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Primary}" Command="{Binding PrintCommand}" c:Ico.Kind="printer" Content="{loc:T Reports.PrintPdf}" />
                    </StackPanel>
                    <TextBlock Text="{loc:T Nav.reports}" Style="{StaticResource H1}" />
                </DockPanel>
                <WrapPanel Margin="0,0,0,14">
                <RadioButton Style="{StaticResource Segment}" Content="{loc:T Reports.Day}" IsChecked="{Binding Preset, Converter={StaticResource Is}, ConverterParameter=day}" />
                <RadioButton Style="{StaticResource Segment}" Content="{loc:T Reports.Week}" IsChecked="{Binding Preset, Converter={StaticResource Is}, ConverterParameter=week}" />
                <RadioButton Style="{StaticResource Segment}" Content="{loc:T Reports.Month}" IsChecked="{Binding Preset, Converter={StaticResource Is}, ConverterParameter=month}" />
                <RadioButton Style="{StaticResource Segment}" Content="{loc:T Reports.Year}" IsChecked="{Binding Preset, Converter={StaticResource Is}, ConverterParameter=year}" />
                <RadioButton Style="{StaticResource Segment}" Content="{loc:T Reports.Custom}" IsChecked="{Binding Preset, Converter={StaticResource Is}, ConverterParameter=custom}" />
                    <DatePicker SelectedDate="{Binding From}" Width="150" Margin="14,0,6,0" IsEnabled="{Binding Preset, Converter={StaticResource Is}, ConverterParameter=custom}" />
                    <DatePicker SelectedDate="{Binding To}" Width="150" IsEnabled="{Binding Preset, Converter={StaticResource Is}, ConverterParameter=custom}" />
                </WrapPanel>

                <c:ResponsiveGrid MinColumnWidth="250" MaxColumns="4">
                    <c:StatCard Title="{loc:T Reports.Revenue}" Value="{Binding Revenue}" Icon="money" Foreground="{DynamicResource Success}" />
                    <c:StatCard Title="{loc:T Reports.Expenses}" Value="{Binding Expenses}" Icon="trending-down" Foreground="{DynamicResource Danger}" />
                    <c:StatCard Title="{loc:T Reports.NetProfit}" Value="{Binding NetProfit}" Icon="chart" />
                    <c:StatCard Title="{loc:T Reports.Unpaid}" Value="{Binding Unpaid}" Icon="alert" Foreground="{DynamicResource Warning}" />
                    <c:StatCard Title="{loc:T Reports.Invoiced}" Value="{Binding Invoiced}" Icon="file" Foreground="{DynamicResource Info}" />
                    <c:StatCard Title="{loc:T Reports.AttendanceRate}" Value="{Binding AttendanceRate}" Icon="check-circle" Foreground="{DynamicResource Success}" />
                    <c:StatCard Title="{loc:T Reports.Enrolments}" Value="{Binding Enrolments}" Icon="user-plus" Foreground="{DynamicResource Info}" />
                    <c:StatCard Title="{loc:T Reports.Departures}" Value="{Binding Departures}" Icon="logout" Foreground="{DynamicResource TextMuted}" />
                </c:ResponsiveGrid>

                <c:ResponsiveGrid MinColumnWidth="320" MaxColumns="3" Margin="0,12,0,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{loc:T Reports.ExpensesByCategory}" Style="{StaticResource H2}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding ExpensesByCategory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource Mono}" FontSize="12" />
                                                <TextBlock Text="{Binding Label}" />
                                            </DockPanel>
                                            <c:Meter Value="{Binding Ratio}" Height="7" Margin="0,4,0,0" Track="{DynamicResource SurfaceAlt}" Fill="{DynamicResource Accent}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{loc:T Common.Nothing}" Style="{StaticResource Muted}" Visibility="{Binding ExpensesByCategory.Count, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{loc:T Reports.ChildrenPerGroup}" Style="{StaticResource H2}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding ChildrenPerGroup}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource Mono}" FontSize="12" />
                                                <TextBlock Text="{Binding Label}" />
                                            </DockPanel>
                                            <c:Meter Value="{Binding Ratio}" Height="7" Margin="0,4,0,0" Track="{DynamicResource SurfaceAlt}" Fill="{DynamicResource Accent}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{loc:T Common.Nothing}" Style="{StaticResource Muted}" Visibility="{Binding ChildrenPerGroup.Count, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{loc:T Reports.RevenueByMethod}" Style="{StaticResource H2}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding RevenueByMethod}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource Mono}" FontSize="12" />
                                                <TextBlock Text="{Binding Label}" />
                                            </DockPanel>
                                            <c:Meter Value="{Binding Ratio}" Height="7" Margin="0,4,0,0" Track="{DynamicResource SurfaceAlt}" Fill="{DynamicResource Accent}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{loc:T Common.Nothing}" Style="{StaticResource Muted}" Visibility="{Binding RevenueByMethod.Count, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Border>
                </c:ResponsiveGrid>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="6">
                    <StackPanel>
                        <TextBlock Text="{loc:T Payments.Debtors}" Style="{StaticResource H2}" Margin="10,8,10,6" />
                        <DataGrid ItemsSource="{Binding Debtors}" MaxHeight="360" loc:GridState.Key="reportDebtors">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:T Common.Family}" Binding="{Binding FamilyName}" Width="*" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{loc:T Common.Phone}" Binding="{Binding Phone}" Width="150" ElementStyle="{StaticResource CellMono}" />
                                <DataGridTextColumn Header="{loc:T Payments.Since}" Binding="{Binding OldestDueDate, Converter={StaticResource Date}}" SortMemberPath="OldestDueDate" Width="120" ElementStyle="{StaticResource CellMono}" />
                                <DataGridTextColumn Header="{loc:T Payments.DaysLate}" Binding="{Binding DaysLate}" Width="120" ElementStyle="{StaticResource CellNumber}" />
                                <DataGridTextColumn Header="{loc:T Payments.AmountDue}" Binding="{Binding AmountDue, Converter={StaticResource Money}}" SortMemberPath="AmountDue" Width="160" ElementStyle="{StaticResource CellNumber}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
