<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Creche.App.Controls"
                    xmlns:loc="clr-namespace:Creche.App.Services"
                    xmlns:vm="clr-namespace:Creche.App.ViewModels">
    <DataTemplate DataType="{x:Type vm:AttendanceViewModel}">
        <DockPanel Margin="26,20,26,20">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Command="{Binding CheckInAllCommand}" c:Ico.Kind="check" Content="{loc:T Attendance.CheckInAll}" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="{loc:T Nav.attendance}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" />
                </StackPanel>
            </DockPanel>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button Style="{StaticResource Ghost}" Command="{Binding ShiftDayCommand}" CommandParameter="-1" Margin="0,0,2,6"><c:Icon Kind="chevron-left" Width="15" Height="15" /></Button>
                <DatePicker SelectedDate="{Binding Date}" Width="150" Margin="0,0,2,6" />
                <Button Style="{StaticResource Ghost}" Command="{Binding ShiftDayCommand}" CommandParameter="1" Margin="0,0,10,6"><c:Icon Kind="chevron-right" Width="15" Height="15" /></Button>
                <Button Command="{Binding TodayCommand}" Content="{loc:T Common.Today}" Margin="0,0,12,6" />
                <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding Group}" DisplayMemberPath="Label" Width="190" Margin="0,0,0,6" />
            </WrapPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource WarningSoft}" CornerRadius="8" Padding="12,8" Margin="0,0,0,10"
                    Visibility="{Binding HasNoGroup, Converter={StaticResource Visible}}">
                <TextBlock Text="{loc:T Attendance.NoGroup}" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" />
            </Border>
            <Border Style="{StaticResource Card}" Padding="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="140" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="status" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <c:Avatar FileName="{Binding Item.PhotoFile}" DisplayName="{Binding Item.FullName}" Width="38" Height="38"
                                                  Background="{DynamicResource SurfaceAlt}" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Item.FullName}" FontWeight="SemiBold" FontSize="14" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Item.GroupName}" Style="{StaticResource Muted}" FontSize="11" />
                                                <Border Style="{StaticResource Chip}" Background="{DynamicResource WarningSoft}" Margin="8,0,0,0" Padding="6,1"
                                                        Visibility="{Binding HasAllergies, Converter={StaticResource Visible}}" ToolTip="{loc:T Children.Allergies}">
                                                    <TextBlock Text="{Binding Item.Allergies}" FontSize="11" Foreground="{DynamicResource Warning}" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Item.AbsenceReason}" Style="{StaticResource Muted}" FontSize="11"
                                                       Visibility="{Binding IsAbsent, Converter={StaticResource Visible}}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource Chip}" Margin="10,0" HorizontalAlignment="Center"
                                                Background="{Binding Item.Status, Converter={StaticResource StatusBrush}, ConverterParameter=soft}"
                                                Visibility="{Binding IsMarked, Converter={StaticResource Visible}}">
                                            <TextBlock Text="{Binding Item.Status, Converter={StaticResource Enum}}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{Binding Item.Status, Converter={StaticResource StatusBrush}}" />
                                        </Border>

                                        <!-- Arrival -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="6,0">
                                            <TextBox Text="{Binding CheckIn, UpdateSourceTrigger=PropertyChanged}" Width="62" Padding="4,6" FontFamily="{StaticResource FontMono}" ToolTip="{loc:T Attendance.CheckIn}" TextAlignment="Center" />
                                            <ComboBox IsEditable="True" ItemsSource="{Binding Item.PickupNames}" Text="{Binding DroppedOffBy, UpdateSourceTrigger=PropertyChanged}" Width="116" Margin="5,0"
                                                      ToolTip="{loc:T Attendance.DroppedBy}" />
                                            <Button Style="{StaticResource SuccessBtn}" Content="{loc:T Attendance.Arrive}" Padding="10,7"
                                                    Command="{Binding DataContext.PresentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <!-- Departure -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0,4,0" IsEnabled="{Binding IsPresent}">
                                            <TextBox Text="{Binding CheckOut, UpdateSourceTrigger=PropertyChanged}" Width="62" Padding="4,6" FontFamily="{StaticResource FontMono}" ToolTip="{loc:T Attendance.CheckOut}" TextAlignment="Center" />
                                            <ComboBox IsEditable="True" ItemsSource="{Binding Item.PickupNames}" Text="{Binding PickedUpBy, UpdateSourceTrigger=PropertyChanged}" Width="116" Margin="5,0"
                                                      ToolTip="{loc:T Attendance.PickedBy}" />
                                            <Button Content="{loc:T Attendance.Leave}" Padding="10,7"
                                                    Command="{Binding DataContext.CheckOutCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="8,0,0,0">
                                            <Button Style="{StaticResource DangerBtn}" Padding="10,7" Content="{loc:T Attendance.Absent}" IsEnabled="{Binding IsCheckedOut, Converter={StaticResource Not}}"
                                                    Command="{Binding DataContext.AbsentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource Ghost}" ToolTip="{loc:T Common.Undo}" IsEnabled="{Binding IsMarked}"
                                                    Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <c:Icon Kind="undo" Width="15" Height="15" />
                                            </Button>
                                            <Button Style="{StaticResource Ghost}" ToolTip="{loc:T Attendance.MonthlySheet}"
                                                    Command="{Binding DataContext.SheetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <c:Icon Kind="calendar" Width="15" Height="15" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
