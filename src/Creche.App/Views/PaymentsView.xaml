<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Creche.App.Controls"
                    xmlns:loc="clr-namespace:Creche.App.Services"
                    xmlns:vm="clr-namespace:Creche.App.ViewModels">
    <DataTemplate DataType="{x:Type vm:PaymentsViewModel}">
        <DockPanel Margin="26,20,26,20">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ExportCsvCommand}" c:Ico.Kind="download" Content="CSV" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Primary}" Command="{Binding AddCommand}" c:Ico.Kind="plus" Content="{loc:T Payments.New}" />
                </StackPanel>
                <TextBlock Text="{loc:T Nav.payments}" Style="{StaticResource H1}" />
            </DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" Content="{loc:T Payments.History}" IsChecked="{Binding Tab, Converter={StaticResource Is}, ConverterParameter=history}" />
                    <RadioButton Style="{StaticResource Segment}" Content="{loc:T Payments.Debtors}" IsChecked="{Binding Tab, Converter={StaticResource Is}, ConverterParameter=debtors}" />
                </StackPanel>
            </Border>
            <Grid>
                <DockPanel Visibility="{Binding Tab, Converter={StaticResource IsVisible}, ConverterParameter=history}">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <DatePicker SelectedDate="{Binding From}" Width="150" Margin="0,0,6,6" />
                        <DatePicker SelectedDate="{Binding To}" Width="150" Margin="0,0,10,6" />
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" Width="230" Margin="0,0,14,6" ToolTip="{loc:T Common.Search}" />
                        <TextBlock Text="{Binding Totals}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,0,6" />
                    </WrapPanel>
                    <Border Style="{StaticResource Card}" Padding="6">
                        <DataGrid ItemsSource="{Binding Payments}" SelectedItem="{Binding Selected}" loc:GridState.Key="payments">
                            <DataGrid.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding PrintCommand}" />
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:T Payments.Receipt}" Binding="{Binding ReceiptNumber}" Width="130" ElementStyle="{StaticResource CellMono}" />
                                <DataGridTextColumn Header="{loc:T Common.Date}" Binding="{Binding Date, Converter={StaticResource Date}}" SortMemberPath="Date" Width="105" ElementStyle="{StaticResource CellMono}" />
                                <DataGridTextColumn Header="{loc:T Common.Family}" Binding="{Binding FamilyName}" Width="*" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{loc:T Payments.Method}" Binding="{Binding Method, Converter={StaticResource Enum}}" SortMemberPath="Method" Width="110" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{loc:T Payments.Reference}" Binding="{Binding Reference}" Width="130" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{loc:T Common.Amount}" Binding="{Binding Amount, Converter={StaticResource Money}}" SortMemberPath="Amount" Width="140" ElementStyle="{StaticResource CellNumber}" />
                                <DataGridTemplateColumn Width="110" SortMemberPath="IsVoided">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Chip}" Background="{DynamicResource DangerSoft}" ToolTip="{Binding VoidReason}"
                                                    Visibility="{Binding IsVoided, Converter={StaticResource Visible}}">
                                                <TextBlock Text="{loc:T Payments.Voided}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Danger}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="Auto" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource Ghost}" MinHeight="28" ToolTip="{loc:T Payments.PrintReceipt}"
                                                    Command="{Binding DataContext.PrintCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                <c:Icon Kind="printer" Width="14" Height="14" />
                                            </Button>
                                            <Button Style="{StaticResource Ghost}" MinHeight="28" ToolTip="{loc:T Payments.Void}"
                                                    Command="{Binding DataContext.VoidCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                <c:Icon Kind="x" Width="14" Height="14" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>

                <DockPanel Visibility="{Binding Tab, Converter={StaticResource IsVisible}, ConverterParameter=debtors}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Command="{Binding PrintDebtorsCommand}" c:Ico.Kind="printer" Content="{loc:T Common.Print}" />
                        <TextBlock Text="{Binding DebtTotal}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Style="{StaticResource Card}" Padding="6">
                        <DataGrid ItemsSource="{Binding Debtors}" loc:GridState.Key="debtors">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:T Common.Family}" Binding="{Binding FamilyName}" Width="*" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{loc:T Families.Guardian}" Binding="{Binding Guardian}" Width="*" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{loc:T Common.Phone}" Binding="{Binding Phone}" Width="140" ElementStyle="{StaticResource CellMono}" />
                                <DataGridTextColumn Header="{loc:T Payments.OpenInvoices}" Binding="{Binding OpenInvoices}" Width="100" ElementStyle="{StaticResource CellNumber}" />
                                <DataGridTextColumn Header="{loc:T Payments.Since}" Binding="{Binding OldestDueDate, Converter={StaticResource Date}}" SortMemberPath="OldestDueDate" Width="110" ElementStyle="{StaticResource CellMono}" />
                                <DataGridTextColumn Header="{loc:T Payments.DaysLate}" Binding="{Binding DaysLate}" Width="110" ElementStyle="{StaticResource CellNumber}" />
                                <DataGridTextColumn Header="{loc:T Payments.AmountDue}" Binding="{Binding AmountDue, Converter={StaticResource Money}}" SortMemberPath="AmountDue" Width="150" ElementStyle="{StaticResource CellNumber}" />
                            <DataGridTemplateColumn Width="Auto" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource Ghost}" MinHeight="28" ToolTip="{loc:T Payments.New}"
                                                    Command="{Binding DataContext.PayDebtorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                <c:Icon Kind="card" Width="14" Height="14" />
                                            </Button>
                                            <Button Style="{StaticResource Ghost}" MinHeight="28" ToolTip="{loc:T Families.File}"
                                                    Command="{Binding DataContext.OpenFamilyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                <c:Icon Kind="users" Width="14" Height="14" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </Grid>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
