<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Creche.App.Controls"
                    xmlns:loc="clr-namespace:Creche.App.Services"
                    xmlns:vm="clr-namespace:Creche.App.ViewModels">
    <DataTemplate DataType="{x:Type vm:ChildrenViewModel}">
        <DockPanel Margin="26,20,26,20">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ExportCsvCommand}" c:Ico.Kind="download" Content="CSV" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Primary}" Command="{Binding EnrolCommand}" c:Ico.Kind="plus" Content="{loc:T Enrolment.New}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{loc:T Nav.children}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding Count}" Style="{StaticResource Muted}" />
                </StackPanel>
            </DockPanel>

            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" Width="240" Margin="0,0,8,6" ToolTip="{loc:T Common.Search}" />
                <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" DisplayMemberPath="Label" Width="160" Margin="0,0,8,6" />
                <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding Group}" DisplayMemberPath="Label" Width="170" Margin="0,0,12,6" />
                <CheckBox Content="{loc:T Common.ShowArchived}" IsChecked="{Binding IncludeArchived}" Margin="0,0,14,6" />
                <CheckBox Content="{loc:T Children.CardView}" IsChecked="{Binding CardView}" Margin="0,0,0,6" />
            </WrapPanel>

            <Border Style="{StaticResource Card}" Padding="6">
                <Grid>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" loc:GridState.Key="children"
                              Visibility="{Binding CardView, Converter={StaticResource Visible}, ConverterParameter=invert}">
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenCommand}" />
                            <KeyBinding Key="Enter" Command="{Binding OpenCommand}" />
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="52" CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <c:Avatar FileName="{Binding PhotoFile}" DisplayName="{Binding FullName}" Width="30" Height="30" Background="{DynamicResource SurfaceAlt}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:T Common.LastName}" Binding="{Binding LastName}" Width="*" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="{loc:T Common.FirstName}" Binding="{Binding FirstName}" Width="*" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="{loc:T Children.Age}" Binding="{Binding DateOfBirth, Converter={StaticResource Age}}" SortMemberPath="DateOfBirth" Width="90" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="{loc:T Common.Group}" Binding="{Binding GroupName}" Width="120" ElementStyle="{StaticResource CellText}" />
                            <DataGridTemplateColumn Header="{loc:T Common.Status}" SortMemberPath="Status" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}" Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=soft}">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource Enum}}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:T Common.Family}" Binding="{Binding FamilyName}" Width="*" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="{loc:T Common.Phone}" Binding="{Binding PrimaryPhone}" Width="130" ElementStyle="{StaticResource CellMono}" />
                            <DataGridTextColumn Header="{loc:T Children.FeePlan}" Binding="{Binding FeePlanName}" Width="*" ElementStyle="{StaticResource CellText}" />
                            <DataGridTemplateColumn Width="44" CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <c:Icon Kind="alert" Width="15" Height="15" Foreground="{DynamicResource Warning}" ToolTip="{loc:T Children.Allergies}"
                                                Visibility="{Binding HasAllergies, Converter={StaticResource Visible}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding CardView, Converter={StaticResource Visible}}" Padding="8">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <c:ResponsiveGrid MinColumnWidth="230" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            Padding="12" HorizontalAlignment="Stretch">
                                        <DockPanel Width="196">
                                            <c:Avatar DockPanel.Dock="Left" FileName="{Binding PhotoFile}" DisplayName="{Binding FullName}" Width="46" Height="46"
                                                      Background="{DynamicResource Surface}" Margin="0,0,12,0" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource Muted}" FontSize="11" FontWeight="Normal" TextWrapping="NoWrap">
                                                    <Run Text="{Binding DateOfBirth, Mode=OneWay, Converter={StaticResource Age}}" /><Run Text="  ·  " /><Run Text="{Binding GroupName, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Status, Converter={StaticResource Enum}}" FontSize="11" Margin="0,2,0,0"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
