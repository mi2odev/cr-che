<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Creche.App.Controls"
                    xmlns:loc="clr-namespace:Creche.App.Services"
                    xmlns:vm="clr-namespace:Creche.App.ViewModels">
    <DataTemplate DataType="{x:Type vm:EnrolmentViewModel}">
        <DockPanel Margin="26,20,26,20">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Command="{Binding EnrolCommand}" c:Ico.Kind="plus" Content="{loc:T Enrolment.New}" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="{loc:T Nav.enrolment}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding SchoolYear, Converter={StaticResource Format}, ConverterParameter=Enrolment.CurrentYear}" Style="{StaticResource Muted}" />
                </StackPanel>
            </DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" IsChecked="{Binding Tab, Converter={StaticResource Is}, ConverterParameter=waiting}">
                        <TextBlock><Run Text="{loc:T Enrolment.WaitingList}" /><Run Text="  " /><Run Text="{Binding WaitingList.Count, Mode=OneWay}" /></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Segment}" IsChecked="{Binding Tab, Converter={StaticResource Is}, ConverterParameter=renew}">
                        <TextBlock><Run Text="{loc:T Enrolment.ToReEnrol}" /><Run Text="  " /><Run Text="{Binding ToReEnrol.Count, Mode=OneWay}" /></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Segment}" IsChecked="{Binding Tab, Converter={StaticResource Is}, ConverterParameter=left}">
                        <TextBlock><Run Text="{loc:T Enrolment.Departures}" /><Run Text="  " /><Run Text="{Binding Departures.Count, Mode=OneWay}" /></TextBlock>
                    </RadioButton>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="6">
                <Grid>
                    <DataGrid ItemsSource="{Binding WaitingList}" loc:GridState.Key="enrolWaiting" Visibility="{Binding Tab, Converter={StaticResource IsVisible}, ConverterParameter=waiting}">
                        <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:T Common.LastName}" Binding="{Binding LastName}" Width="*" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{loc:T Common.FirstName}" Binding="{Binding FirstName}" Width="*" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{loc:T Children.Age}" Binding="{Binding DateOfBirth, Converter={StaticResource Age}}" SortMemberPath="DateOfBirth" Width="90" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{loc:T Common.Group}" Binding="{Binding GroupName}" Width="120" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{loc:T Common.Phone}" Binding="{Binding PrimaryPhone}" Width="130" ElementStyle="{StaticResource CellMono}" />
                            <DataGridTemplateColumn Width="Auto" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource Primary}" MinHeight="28" Padding="10,3" FontSize="12" Margin="0,0,6,0" Content="{loc:T Enrolment.Admit}"
                                                    Command="{Binding DataContext.AdmitCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource Ghost}" MinHeight="28" ToolTip="{loc:T Children.File}"
                                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                <c:Icon Kind="file" Width="14" Height="14" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid ItemsSource="{Binding ToReEnrol}" loc:GridState.Key="enrolRenew" Visibility="{Binding Tab, Converter={StaticResource IsVisible}, ConverterParameter=renew}">
                        <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:T Common.LastName}" Binding="{Binding LastName}" Width="*" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{loc:T Common.FirstName}" Binding="{Binding FirstName}" Width="*" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{loc:T Children.Age}" Binding="{Binding DateOfBirth, Converter={StaticResource Age}}" SortMemberPath="DateOfBirth" Width="90" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{loc:T Common.Group}" Binding="{Binding GroupName}" Width="120" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{loc:T Common.Phone}" Binding="{Binding PrimaryPhone}" Width="130" ElementStyle="{StaticResource CellMono}" />
                                <DataGridTextColumn Header="{loc:T Settings.SchoolYear}" Binding="{Binding SchoolYear}" Width="110" ElementStyle="{StaticResource CellMono}" />
                            <DataGridTemplateColumn Width="Auto" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource Primary}" MinHeight="28" Padding="10,3" FontSize="12" Margin="0,0,6,0" Content="{loc:T Enrolment.ReEnrol}"
                                                    Command="{Binding DataContext.ReEnrolCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource DangerBtn}" MinHeight="28" Padding="10,3" FontSize="12" Margin="0,0,6,0" Content="{loc:T Enrolment.Leave}"
                                                    Command="{Binding DataContext.LeaveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource Ghost}" MinHeight="28" ToolTip="{loc:T Children.File}"
                                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                <c:Icon Kind="file" Width="14" Height="14" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid ItemsSource="{Binding Departures}" loc:GridState.Key="enrolLeft" Visibility="{Binding Tab, Converter={StaticResource IsVisible}, ConverterParameter=left}">
                        <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:T Common.LastName}" Binding="{Binding LastName}" Width="*" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{loc:T Common.FirstName}" Binding="{Binding FirstName}" Width="*" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{loc:T Children.Age}" Binding="{Binding DateOfBirth, Converter={StaticResource Age}}" SortMemberPath="DateOfBirth" Width="90" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{loc:T Common.Group}" Binding="{Binding GroupName}" Width="120" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{loc:T Common.Phone}" Binding="{Binding PrimaryPhone}" Width="130" ElementStyle="{StaticResource CellMono}" />
                                <DataGridTextColumn Header="{loc:T Enrolment.LeaveDate}" Binding="{Binding LeaveDate, Converter={StaticResource Date}}" SortMemberPath="LeaveDate" Width="110" ElementStyle="{StaticResource CellMono}" />
                            <DataGridTemplateColumn Width="Auto" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource Small}" MinHeight="28" Padding="10,3" FontSize="12" Margin="0,0,6,0" Content="{loc:T Enrolment.ReEnrol}"
                                                    Command="{Binding DataContext.ReEnrolCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource Ghost}" MinHeight="28" ToolTip="{loc:T Children.File}"
                                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                <c:Icon Kind="file" Width="14" Height="14" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
