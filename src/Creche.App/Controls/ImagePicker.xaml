<UserControl x:Class="Creche.App.Controls.ImagePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Creche.App.Controls"
             xmlns:loc="clr-namespace:Creche.App.Services"
             x:Name="root" AllowDrop="True" Focusable="False">
    <StackPanel>
        <Border x:Name="dropZone" Width="{Binding PreviewSize, ElementName=root}" Height="{Binding PreviewSize, ElementName=root}"
                CornerRadius="14" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1.5"
                Cursor="Hand" MouseLeftButtonUp="OnBrowse" ToolTip="{loc:T Image.Hint}">
            <Grid>
                <StackPanel x:Name="placeholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <c:Icon Kind="image" Width="26" Height="26" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" />
                    <TextBlock Text="{loc:T Image.Drop}" Style="{StaticResource Muted}" TextAlignment="Center" Margin="6,6,6,0" FontSize="11" />
                </StackPanel>
                <Border x:Name="preview" CornerRadius="13" Visibility="Collapsed" FlowDirection="LeftToRight" />
            </Grid>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
            <Button Style="{StaticResource Small}" Click="OnBrowse" Content="{loc:T Image.Choose}" />
            <Button x:Name="removeButton" Style="{StaticResource Ghost}" Click="OnRemove" Margin="4,0,0,0" MinHeight="28" ToolTip="{loc:T Common.Remove}">
                <c:Icon Kind="x" Width="14" Height="14" />
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
